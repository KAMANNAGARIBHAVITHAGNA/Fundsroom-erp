# Server config
PORT=5000
NODE_ENV=development

# Database connection (Supabase PostgreSQL URL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require

# JWT Secret for Auth Token signature
JWT_SECRET=fundsroom-default-secret-key-12345

# Allowed origins for CORS (comma-separated list for production)
ALLOWED_ORIGINS=http://localhost:5173

# Demo login active mode
DEMO_MODE=true
